<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AI Personal Finance Dashboard</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:'Poppins',sans-serif;
        }

        body{
            background:#eef3f9;
        }

        /* NAVBAR */

        .navbar{
            width:100%;
            padding:20px 40px;
            background:linear-gradient(135deg,#0f172a,#1e293b);
            display:flex;
            justify-content:space-between;
            align-items:center;
            color:white;
            box-shadow:0px 5px 20px rgba(0,0,0,0.2);
            position:sticky;
            top:0;
            z-index:1000;
        }

        .logo{
            font-size:32px;
            font-weight:700;
            letter-spacing:1px;
        }

        .nav-links{
            display:flex;
            gap:25px;
        }

        .nav-links a{
            color:white;
            text-decoration:none;
            font-size:16px;
            transition:0.3s;
        }

        .nav-links a:hover{
            color:#38bdf8;
        }

        /* HERO SECTION */

        .hero{
            width:92%;
            margin:auto;
            margin-top:30px;
            background:linear-gradient(135deg,#2563eb,#06b6d4);
            padding:50px;
            border-radius:25px;
            color:white;
            display:flex;
            justify-content:space-between;
            align-items:center;
            flex-wrap:wrap;
            box-shadow:0px 10px 25px rgba(0,0,0,0.15);
        }

        .hero-text h1{
            font-size:42px;
            margin-bottom:15px;
        }

        .hero-text p{
            font-size:17px;
            line-height:1.8;
            max-width:650px;
        }

        .hero-icon{
            font-size:100px;
            opacity:0.3;
        }

        /* MAIN */

        .container{
            width:92%;
            margin:auto;
            margin-top:35px;
        }

        /* SUMMARY */

        .summary{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
            gap:25px;
            margin-bottom:35px;
        }

        .summary-box{
            background:white;
            padding:35px;
            border-radius:22px;
            box-shadow:0px 5px 20px rgba(0,0,0,0.08);
            transition:0.3s;
            position:relative;
            overflow:hidden;
        }

        .summary-box:hover{
            transform:translateY(-7px);
        }

        .summary-box::before{
            content:"";
            position:absolute;
            width:100%;
            height:6px;
            background:linear-gradient(to right,#2563eb,#06b6d4);
            top:0;
            left:0;
        }

        .summary-box i{
            font-size:40px;
            color:#2563eb;
            margin-bottom:15px;
        }

        .summary-box h3{
            color:#555;
            margin-bottom:10px;
        }

        .summary-box p{
            font-size:35px;
            font-weight:bold;
            color:#0f172a;
        }

        /* CARD */

        .card{
            background:white;
            padding:35px;
            border-radius:22px;
            margin-bottom:35px;
            box-shadow:0px 5px 20px rgba(0,0,0,0.08);
        }

        .card h2{
            color:#0f172a;
            margin-bottom:25px;
            font-size:30px;
        }

        /* FORM */

        .form-grid{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
            gap:20px;
        }

        input{
            width:100%;
            padding:16px;
            border-radius:14px;
            border:1px solid #dcdcdc;
            outline:none;
            font-size:15px;
            transition:0.3s;
        }

        input:focus{
            border-color:#2563eb;
            box-shadow:0px 0px 10px rgba(37,99,235,0.2);
        }

        button{
            padding:15px 28px;
            border:none;
            border-radius:14px;
            background:linear-gradient(to right,#2563eb,#06b6d4);
            color:white;
            font-size:15px;
            font-weight:600;
            cursor:pointer;
            transition:0.3s;
        }

        button:hover{
            transform:scale(1.05);
        }

        /* TABLE */

        .table-container{
            overflow-x:auto;
        }

        table{
            width:100%;
            border-collapse:collapse;
        }

        table th{
            background:#0f172a;
            color:white;
            padding:18px;
        }

        table td{
            padding:16px;
            border-bottom:1px solid #eee;
            text-align:center;
        }

        table tr:hover{
            background:#f1f5f9;
        }

        /* FEATURES */

        .feature-box{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
            gap:25px;
            margin-top:25px;
        }

        .feature{
            background:#f8fbff;
            padding:28px;
            border-radius:18px;
            border-left:5px solid #2563eb;
            transition:0.3s;
        }

        .feature:hover{
            transform:translateY(-5px);
        }

        .feature i{
            font-size:35px;
            color:#2563eb;
            margin-bottom:15px;
        }

        .feature h3{
            margin-bottom:10px;
            color:#0f172a;
        }

        .feature p{
            color:#666;
            line-height:1.7;
        }

        /* BUTTON GROUP */

        .btn-group{
            margin-top:30px;
            display:flex;
            flex-wrap:wrap;
            gap:15px;
        }

        .btn-group a{
            text-decoration:none;
        }

        /* FOOTER */

        .footer{
            background:#0f172a;
            color:white;
            text-align:center;
            padding:25px;
            margin-top:50px;
        }

        /* MOBILE */

        @media(max-width:768px){

            .navbar{
                flex-direction:column;
                gap:15px;
            }

            .hero{
                text-align:center;
                padding:35px;
            }

            .hero-text h1{
                font-size:30px;
            }

            .hero-icon{
                margin-top:20px;
                font-size:70px;
            }

            .btn-group{
                flex-direction:column;
            }

            button{
                width:100%;
            }

        }

    </style>

</head>

<body>

    <!-- NAVBAR -->

    <div class="navbar">

        <div class="logo">
            💰 Finance AI
        </div>

        <div class="nav-links">

            <a href="/dashboard">Dashboard</a>

            <a href="/charts">Charts</a>

            <a href="/budget_prediction">Budget</a>

            <a href="/ai_advice">AI Advisor</a>

            <a href="/download_report">Reports</a>

        </div>

    </div>

    <!-- HERO -->

    <div class="hero">

        <div class="hero-text">

            <h1>AI Personal Finance Assistant</h1>

            <p>
                Track your expenses, analyze spending habits,
                generate smart AI financial advice, predict future budgets,
                and download professional reports with advanced
                AI-powered finance management tools.
            </p>

        </div>

        <div class="hero-icon">
            <i class="fa-solid fa-wallet"></i>
        </div>

    </div>

    <!-- MAIN CONTAINER -->

    <div class="container">

        <!-- SUMMARY -->

        <div class="summary">

            <div class="summary-box">

                <i class="fa-solid fa-money-bill-trend-up"></i>

                <h3>Total Expense</h3>

                <p>₹ {{ total }}</p>

            </div>

            <div class="summary-box">

                <i class="fa-solid fa-receipt"></i>

                <h3>Total Transactions</h3>

                <p>{{ expenses|length }}</p>

            </div>

            <div class="summary-box">

                <i class="fa-solid fa-piggy-bank"></i>

                <h3>Monthly Budget</h3>

                <p>₹ 50,000</p>

            </div>

        </div>

        <!-- ADD EXPENSE -->

        <div class="card">

            <h2>➕ Add New Expense</h2>

            <form action="/add_expense" method="POST">

                <div class="form-grid">

                    <input
                        type="text"
                        name="title"
                        placeholder="Enter Expense Title"
                        required
                    >

                    <input
                        type="number"
                        name="amount"
                        placeholder="Enter Amount"
                        required
                    >

                    <input
                        type="text"
                        name="category"
                        placeholder="Enter Expense Category"
                        required
                    >

                </div>

                <br>

                <button type="submit">
                    Add Expense
                </button>

            </form>

        </div>

        <!-- EXPENSE TABLE -->

        <div class="card">

            <h2>📊 Expense Records</h2>

            <div class="table-container">

                <table>

                    <tr>

                        <th>ID</th>

                        <th>Title</th>

                        <th>Amount</th>

                        <th>Category</th>

                    </tr>

                    {% for expense in expenses %}

                    <tr>

                        <td>{{ expense[0] }}</td>

                        <td>{{ expense[1] }}</td>

                        <td>₹ {{ expense[2] }}</td>

                        <td>{{ expense[3] }}</td>

                    </tr>

                    {% endfor %}

                </table>

            </div>

        </div>

        <!-- AI FEATURES -->

        <div class="card">

            <h2>🤖 AI Financial Services</h2>

            <p>
                Advanced Artificial Intelligence modules to improve your
                savings, spending control, and future financial planning.
            </p>

            <div class="feature-box">

                <div class="feature">

                    <i class="fa-solid fa-robot"></i>

                    <h3>AI Financial Advice</h3>

                    <p>
                        Personalized AI suggestions for savings,
                        investment ideas, and expense reduction.
                    </p>

                </div>

                <div class="feature">

                    <i class="fa-solid fa-chart-line"></i>

                    <h3>Budget Prediction</h3>

                    <p>
                        Predict future expenses and monthly financial trends.
                    </p>

                </div>

                <div class="feature">

                    <i class="fa-solid fa-chart-pie"></i>

                    <h3>Expense Visualization</h3>

                    <p>
                        View beautiful charts and financial analytics reports.
                    </p>

                </div>

            </div>

            <div class="btn-group">

                <a href="/ai_advice">
                    <button>AI Advice</button>
                </a>

                <a href="/budget_prediction">
                    <button>Budget Prediction</button>
                </a>

                <a href="/charts">
                    <button>Expense Charts</button>
                </a>

                <a href="/download_report">
                    <button>Download PDF Report</button>
                </a>

            </div>

        </div>

    </div>

    <!-- FOOTER -->

    <div class="footer">

        AI Personal Finance Assistant © 2026 | Flask + MySQL + AI Powered System

    </div>

</body>

</html>
